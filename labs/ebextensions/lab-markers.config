# Lab 11: see when each .ebextensions section runs. Copy to .ebextensions/lab-markers.config.
# Each step writes a marker file; the Overview page lists them under "Lab markers".
files:
  "/tmp/beanstalk-lab/files-section.txt":
    mode: "000644"
    owner: root
    group: root
    content: |
      Written by the `files` section of .ebextensions.
      `files` runs before `commands`, and before your app is extracted.

commands:
  01_commands_marker:
    # `commands` runs as root BEFORE the app is extracted. The working directory is not your app.
    command: "mkdir -p /tmp/beanstalk-lab && echo \"commands section ran at $(date -u) on $(hostname)\" > /tmp/beanstalk-lab/commands-section.txt"

container_commands:
  01_container_marker:
    # `container_commands` runs AFTER the app is extracted, in the staging directory (/var/app/staging).
    command: "mkdir -p lab-markers && echo \"container_commands ran at $(date -u) in $(pwd) on $(hostname)\" > lab-markers/container-commands.txt"
  02_leader_only:
    # Runs on only ONE instance per deployment (useful for DB migrations).
    command: "echo \"I was the deployment leader at $(date -u)\" > lab-markers/leader-only.txt"
    leader_only: true
