# Lab 9 (advanced): canary deployment. Requires an Application Load Balancer.
# 20% of traffic goes to the new version for 5 minutes; if it stays healthy, it gets 100%.
option_settings:
  aws:elasticbeanstalk:command:
    DeploymentPolicy: TrafficSplitting
  aws:elasticbeanstalk:trafficsplitting:
    NewVersionPercent: "20"
    EvaluationTime: "5"
