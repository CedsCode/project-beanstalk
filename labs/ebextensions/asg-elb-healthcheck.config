# Lab 7 (optional): make the Auto Scaling group REPLACE instances that fail the
# load balancer health check. The default type is EC2, which only replaces an
# instance if the EC2 instance itself dies.
# Only valid in load-balanced environments.
Resources:
  AWSEBAutoScalingGroup:
    Type: "AWS::AutoScaling::AutoScalingGroup"
    Properties:
      HealthCheckType: ELB
      HealthCheckGracePeriod: 300
