# Lab 8: scale on CPU. Copy to .ebextensions/autoscaling.config (load-balanced environments only).
# Min/Max instance counts are NOT set here on purpose: if you ran `eb scale`, that
# direct setting overrides .ebextensions. Set capacity with `eb config` instead.
option_settings:
  aws:autoscaling:trigger:
    MeasureName: CPUUtilization
    Statistic: Average
    Unit: Percent
    Period: 1                     # minutes per data point
    BreachDuration: 2             # minutes above/below the threshold before acting
    UpperThreshold: 60
    UpperBreachScaleIncrement: 1
    LowerThreshold: 20
    LowerBreachScaleIncrement: -1
