# Lab 15: worker tier settings. Copy to .ebextensions/worker.config before deploying to a WORKER environment.
option_settings:
  aws:elasticbeanstalk:sqsd:
    HttpPath: /worker/task        # where the SQS daemon POSTs each message (the default is /)
    VisibilityTimeout: 60         # seconds a message is hidden while being processed
    InactivityTimeout: 30         # seconds the daemon waits for your app to respond
